config {
  type: "incremental",
  schema: "parkflow_silver",
  description: "Silver: valid, de-duplicated sensor events. One row per event_id (idempotent MERGE).",
  uniqueKey: ["event_id"],
  bigquery: {
    partitionBy: "DATE(event_ts)",
    clusterBy: ["lot_id", "spot_id"],
    requirePartitionFilter: true,
    updatePartitionFilter: "event_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${dataform.projectConfig.vars.silver_lookback_days} DAY)"
  },
  tags: ["silver"]
}

-- uniqueKey makes Dataform generate a MERGE on event_id:
-- re-running the same Bronze files never creates duplicates (idempotency).
SELECT
  event_id, event_ts, sent_ts, lot_id, spot_id, sensor_id, status,
  battery_pct, rssi_dbm, firmware, bronze_dt, delivery_delay_sec,
  delivery_delay_sec > 300 AS is_late,
  CURRENT_TIMESTAMP() AS silver_loaded_at
FROM ${ref("bronze_validated")}
WHERE error_reason IS NULL
${when(incremental(),
  `AND bronze_dt >= (SELECT DATE_SUB(MAX(bronze_dt), INTERVAL 1 DAY) FROM ${self()}
                     WHERE event_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${dataform.projectConfig.vars.silver_lookback_days} DAY))`)}
-- Duplicates inside the same batch: keep the first copy that arrived.
QUALIFY ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY sent_ts) = 1
